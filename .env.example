# Public URL used for OAuth callbacks and absolute links.
APP_URL=https://smartylang.com
HOST=127.0.0.1
# Development review servers can serve dist without enabling Vite middleware.
SERVE_BUILT_APP=1

# ── Self-hosted PostgreSQL / sessions ───────────────────────────────────────
DATABASE_URL=postgres://smarty_app:CHANGE_ME@127.0.0.1:5432/smartylang
DATABASE_POOL_SIZE=10
DATABASE_SSL=true
# Optional PEM CA certificate, with literal \n separators, for a private DB CA.
DATABASE_CA_CERT=
NODE_ENV=production
TRUST_PROXY=1
AGE_PROOF_SECRET=
LEGAL_OPERATOR=
LEGAL_CONTACT_EMAIL=
AI_DAILY_REQUEST_CAP=1000
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=
CONTENT_SAFETY_LANGUAGES=en,es,fr,de,it,pt,zh,ja
SESSION_SECRET=generate-a-long-random-value
ADMIN_EMAIL=abduraxmonovibroxim16@gmail.com

# Google OAuth (server-side; callback must match the Google Cloud console)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://smartylang.com/api/auth/google/callback

# ── Microsoft Azure Text-to-Speech (server / Cloud Function only) ─────────
# Create an Azure Speech resource: https://portal.azure.com → Azure AI services → Speech
# In the resource, copy the KEY and REGION (e.g. eastus, westeurope).
# Local: used by Express /api/tts.
# Prod:  firebase functions:secrets:set AZURE_SPEECH_KEY
#        firebase functions:secrets:set AZURE_SPEECH_REGION
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Optional official Cloud Translation API key (v2). Cloud Functions also try
# Translation v3 via Application Default Credentials on the Firebase project.
# Local bulk first-pass lang-pack generation also uses this when present.
GOOGLE_TRANSLATE_API_KEY=
OPENROUTER_API_KEY=
# Optional: set to 0 to disable the predetermined vocab database (legacy API only).
VITE_VOCAB_DB=1

# ── Dodo Payments ───────────────────────────────────────────────────────────
# API key from Developer → API Keys in the Dodo Payments dashboard.
DODO_PAYMENTS_API_KEY=
# Create one Dodo product per plan (fixed price) and paste each product ID below.
DODO_PAYMENTS_PRODUCT_ID_MAX=
DODO_PAYMENTS_PRODUCT_ID_BUSINESS=
# Legacy single-product env (falls back for Max only if MAX is unset)
DODO_PAYMENTS_PRODUCT_ID=
# test_mode or live_mode (defaults to live_mode)
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Recurring product IDs for additional combinations, e.g. {"business:10:1":"product-id"}
DODO_PAYMENTS_PRICE_CATALOG={}
# Webhook signing secret from Developer → Webhooks → your endpoint → Overview
DODO_PAYMENTS_WEBHOOK_SECRET=

