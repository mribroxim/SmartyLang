# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Firebase ─────────────────────────────────────────────────────────────────
# Paste the values from your Firebase project console:
# Project Settings → Your apps → Web app → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# If using a named Firestore database, put its ID here; otherwise leave as (default)
VITE_FIREBASE_DATABASE_ID=(default)

# ── Microsoft Azure Text-to-Speech (server / Cloud Function only) ─────────
# Create an Azure Speech resource: https://portal.azure.com → Azure AI services → Speech
# In the resource, copy the KEY and REGION (e.g. eastus, westeurope).
# Local: used by Express /api/tts.
# Prod:  firebase functions:secrets:set AZURE_SPEECH_KEY
#        firebase functions:secrets:set AZURE_SPEECH_REGION
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Optional official Cloud Translation API key (v2). Cloud Functions also try
# Translation v3 via Application Default Credentials on the Firebase project.
# Optional: set to 0 to disable the predetermined vocab database (legacy API only).
VITE_VOCAB_DB=1

# ── ATMOS Payment (Uzbekistan) ──────────────────────────────────────────────
# From your ATMOS merchant dashboard at https://atmos.uz
VITE_ATMOS_MERCHANT_ID=
VITE_ATMOS_STORE_ID=
VITE_ATMOS_FORM_URL=https://checkout.pays.uz/atmos/payment-form
VITE_ATMOS_SUCCESS_URL=https://smarty-english-c0532.web.app/?payment=success
VITE_ATMOS_CANCEL_URL=https://smarty-english-c0532.web.app/?payment=cancel

