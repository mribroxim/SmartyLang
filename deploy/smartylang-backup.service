[Unit]
Description=Encrypted SmartyLang PostgreSQL backup
After=network-online.target postgresql.service
[Service]
Type=oneshot
User=smartylang-backup
EnvironmentFile=/etc/smartylang/backup.env
ExecStart=/usr/bin/bash /srv/smartylang/app/scripts/ops/backup-postgres.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/smartylang
