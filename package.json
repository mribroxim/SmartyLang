{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node --experimental-strip-types server.ts",
    "migrate:export": "node scripts/migrate/export-firebase.mjs",
    "migrate:import": "node scripts/migrate/import-postgres.mjs",
    "db:migrate": "node --experimental-strip-types -e \"import('./server/db.ts').then(({runMigrations}) => runMigrations())\"",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "build:vocab": "node scripts/build-vocab-db.mjs",
    "seed:lang-packs": "scripts/local-mt/.venv/Scripts/python.exe scripts/local-mt/seed_lang_packs.py",
    "verify:vocab": "node scripts/verify-vocab-quality.mjs",
    "localize:uz": "node scripts/localize/localize-uz-level-texts.mjs",
    "localize:uz:validate": "node scripts/localize/validate-localized.mjs",
    "localize:uz:sense": "node scripts/localize/validate-sense.mjs",
    "localize:uz:merge": "node scripts/localize/merge-rebuild.mjs",
    "localize:uz:merge:wait": "node scripts/localize/merge-rebuild.mjs --wait",
    "localize:uz:critic": "node scripts/localize/critic-pass.mjs --all",
    "test": "vitest run && node --test tests/ui-locales.test.mjs",
    "test:watch": "vitest",
    "check": "tsc --noEmit -p .",
    "locales:generate": "node scripts/gen-ui-locales.mjs",
    "locales:audit": "node scripts/audit-ui-locales.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "argon2": "^0.45.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "google-auth-library": "^11.0.2",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.546.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "qs": "^6.16.2"
  }
}
